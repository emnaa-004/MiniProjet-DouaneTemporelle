<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:weightSum="1"
    android:padding="16dp">

    <ImageView
        android:id="@+id/img_passeport_adem"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="centerInside"
        android:background="#DDDDDD"/>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="10dp">

        <TextView
            android:id="@+id/tv_titre_adem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Résumé du dossier"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_resume_adem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_titre_adem"
            android:textSize="16sp"
            android:layout_marginTop="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_approuver_adem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Approuver le saut temporel"
                android:backgroundTint="#4CAF50"/>

            <Button
                android:id="@+id/btn_refuser_adem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Refuser (Risque de paradoxe)"
                android:backgroundTint="#F44336"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>